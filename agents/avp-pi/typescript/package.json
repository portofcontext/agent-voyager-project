{
  "name": "avp-pi",
  "version": "0.1.3",
  "description": "AVP adapter for the Pi coding agent.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "avp-pi-cli": "./dist/src/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check src tests package.json tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@agent-voyager-project/sdk": "https://github.com/portofcontext/agent-voyager-project/releases/download/sdk-typescript-v0.1.0-beta.2/agent-voyager-project-sdk-0.1.0-beta.2.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "prettier": "^3.9.10"
  }
}
