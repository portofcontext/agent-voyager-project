{
  "name": "avp-opencode",
  "version": "0.1.4",
  "description": "AVP adapter for the OpenCode coding agent.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "avp-opencode-cli": "./dist/src/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node node_modules/opencode-ai/postinstall.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check src tests package.json tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js"
  },
  "dependencies": {
    "@agent-voyager-project/sdk": "file:../../../avp-sdk/typescript",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@opencode-ai/sdk": "1.18.34",
    "opencode-ai": "1.18.34",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
