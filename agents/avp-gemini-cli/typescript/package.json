{
  "name": "avp-gemini-cli",
  "version": "0.1.2",
  "description": "AVP adapter for Gemini CLI.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "avp-gemini-cli-cli": "./dist/src/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check src tests package.json tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@agent-voyager-project/sdk": "https://github.com/portofcontext/agent-voyager-project/releases/download/sdk-typescript-v0.1.0-beta.1/agent-voyager-project-sdk-0.1.0-beta.1.tgz",
    "@google/gemini-cli": "0.63.0",
    "@google/gemini-cli-core": "0.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
