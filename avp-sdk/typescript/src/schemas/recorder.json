{
  "$defs": {
    "AgentDescriptor": {
      "additionalProperties": false,
      "description": "What an agent comes with before any Commission.",
      "properties": {
        "avp_version": {
          "const": "0.1",
          "description": "The AVP version the Descriptor follows.",
          "title": "Avp Version",
          "type": "string"
        },
        "agent_name": {
          "description": "The agent's name.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Agent Name",
          "type": "string"
        },
        "agent_version": {
          "description": "The agent's version.",
          "title": "Agent Version",
          "type": "string"
        },
        "supported_models": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ModelPattern"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The models the agent can run. Absent means the agent does not say.",
          "title": "Supported Models"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The system prompt the agent comes with.",
          "title": "System Prompt"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Tool"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The agent's built-in tools, including those that come from its MCP servers.",
          "title": "Tools"
        },
        "mcp_servers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/McpServer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The MCP servers the agent comes with.",
          "title": "Mcp Servers"
        },
        "skills": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/avp__descriptor__Skill"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The skills the agent comes with.",
          "title": "Skills"
        },
        "subagents": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Subagent"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The subagents the agent comes with.",
          "title": "Subagents"
        }
      },
      "required": [
        "avp_version",
        "agent_name",
        "agent_version"
      ],
      "title": "AgentDescriptor",
      "type": "object"
    },
    "AgentSettings": {
      "additionalProperties": false,
      "description": "Settings for the agent whose `agent_name` is their key in `agents`.",
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The `agent_version` the Commission was written for.",
          "title": "Version"
        },
        "enabled_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The built-in tools the run may use, by name. Covers only tools without an\n`mcp_server_id`.",
          "title": "Enabled Tools"
        },
        "enabled_subagents": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The built-in subagents the run may use, by name.",
          "title": "Enabled Subagents"
        },
        "enabled_skills": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The built-in skills the run may use, by name.",
          "title": "Enabled Skills"
        },
        "enabled_mcp_servers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The built-in MCP servers the run may use, by `id`.",
          "title": "Enabled Mcp Servers"
        }
      },
      "title": "AgentSettings",
      "type": "object"
    },
    "Call": {
      "additionalProperties": false,
      "description": "A tool call. `server_side` when the model service runs the tool and\nreturns its result in the same response, as a `ServerResult`.",
      "properties": {
        "type": {
          "const": "call",
          "default": "call",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "server_side": {
          "default": false,
          "title": "Server Side",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "title": "Call",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": true,
      "description": "A source the model cited. Keeps fields the service added.",
      "properties": {
        "type": {
          "description": "The kind of citation, as the model service names it, such as `url_citation`.",
          "title": "Type",
          "type": "string"
        },
        "cited_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text cited.",
          "title": "Cited Text"
        },
        "start_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the cited part of the text starts.",
          "title": "Start Index"
        },
        "end_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where it ends.",
          "title": "End Index"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The service's ID for the source.",
          "title": "Source Id"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source's URL.",
          "title": "Source Url"
        },
        "source_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source's title.",
          "title": "Source Title"
        }
      },
      "required": [
        "type"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Commission": {
      "additionalProperties": false,
      "description": "What one run should do: the task and the settings for the run.",
      "properties": {
        "avp_version": {
          "const": "0.1",
          "description": "The AVP version the Commission follows.",
          "title": "Avp Version",
          "type": "string"
        },
        "run_id": {
          "description": "The run's ID, chosen by the supervisor.",
          "title": "Run Id",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/Model",
          "description": "The model to run, and the service that runs it."
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The system prompt for the run. It replaces the agent's own.",
          "title": "System Prompt"
        },
        "prompt": {
          "description": "The first user message of the run.",
          "title": "Prompt",
          "type": "string"
        },
        "supervisor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Supervisor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The supervisor that wrote the Commission."
        },
        "mcp_servers": {
          "anyOf": [
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "http": "#/$defs/McpServerHttp",
                    "stdio": "#/$defs/McpServerStdio"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/McpServerHttp"
                  },
                  {
                    "$ref": "#/$defs/McpServerStdio"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MCP servers to add for the run.",
          "title": "Mcp Servers"
        },
        "skills": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/avp__commission__Skill"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Skills to add for the run.",
          "title": "Skills"
        },
        "agents": {
          "anyOf": [
            {
              "patternProperties": {
                "^[a-z0-9_-]+$": {
                  "$ref": "#/$defs/AgentSettings"
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Settings for specific agents, keyed by `agent_name`.",
          "title": "Agents"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "properties": {
                "type": {
                  "const": "object"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A JSON Schema for the agent's final output. Its `type` is `\"object\"`.",
          "title": "Output Schema"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An ID that groups related runs, such as the turns of one conversation.",
          "title": "Thread Id"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Labels for the run.",
          "title": "Tags"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key-value data for the supervisor's own use.",
          "title": "Meta"
        }
      },
      "required": [
        "avp_version",
        "run_id",
        "model",
        "prompt"
      ],
      "title": "Commission",
      "type": "object"
    },
    "EnvSecret": {
      "additionalProperties": false,
      "description": "A secret in a variable of the agent's environment.",
      "properties": {
        "env": {
          "description": "The name of a variable in the agent's environment that holds the secret,\nfor example `\"TEST_DB_PASSWORD\"`.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "EnvSecret",
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "description": "An image saved beside the Trajectory. Made by `Recorder.image`.",
      "properties": {
        "type": {
          "const": "image",
          "default": "image",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "media_type"
      ],
      "title": "Image",
      "type": "object"
    },
    "JsonValue": {},
    "McpServer": {
      "additionalProperties": false,
      "description": "An MCP server the agent comes with. Connection details stay inside the agent.",
      "properties": {
        "id": {
          "description": "Identifies the server. A Tool's `mcp_server_id` refers to it.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A display name, when it differs from `id`.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server provides.",
          "title": "Description"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "connected",
                "failed",
                "needs-auth",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The result of the agent's attempt to connect.",
          "title": "Status"
        }
      },
      "required": [
        "id"
      ],
      "title": "McpServer",
      "type": "object"
    },
    "McpServerHttp": {
      "additionalProperties": false,
      "description": "An MCP server the agent connects to over Streamable HTTP.",
      "properties": {
        "id": {
          "description": "Identifies the server.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A display name, when it differs from `id`.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server provides.",
          "title": "Description"
        },
        "type": {
          "const": "http",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "description": "The server's URL.",
          "title": "Url",
          "type": "string"
        },
        "headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/ProxySecret"
                  },
                  {
                    "$ref": "#/$defs/EnvSecret"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP headers to send with each request. A Secret reference's secret is\nthe header's entire value.",
          "title": "Headers"
        }
      },
      "required": [
        "id",
        "type",
        "url"
      ],
      "title": "McpServerHttp",
      "type": "object"
    },
    "McpServerStdio": {
      "additionalProperties": false,
      "description": "An MCP server the agent starts as a local program and talks to over stdio.",
      "properties": {
        "id": {
          "description": "Identifies the server.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A display name, when it differs from `id`.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server provides.",
          "title": "Description"
        },
        "type": {
          "const": "stdio",
          "title": "Type",
          "type": "string"
        },
        "command": {
          "description": "The program and its arguments, for example `[\"npx\", \"-y\", \"@example/db-mcp\"]`.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "env": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/EnvSecret"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Environment variables to set for the program, on top of those the\nagent's MCP client gives it.",
          "title": "Env"
        }
      },
      "required": [
        "id",
        "type",
        "command"
      ],
      "title": "McpServerStdio",
      "type": "object"
    },
    "Model": {
      "additionalProperties": false,
      "description": "A model as one service offers it, named with models.dev provider and model IDs.",
      "properties": {
        "provider": {
          "description": "The service that runs the model, for example `\"anthropic\"`,\n`\"amazon-bedrock\"`, or `\"openrouter\"`. It decides which API the agent calls\nand how it authenticates.",
          "pattern": "^[a-z0-9._-]+$",
          "title": "Provider",
          "type": "string"
        },
        "id": {
          "description": "The model's ID at that service, as the agent sends it, for example\n`\"claude-sonnet-4-6\"`.",
          "title": "Id",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The URL of the service's API. Absent means the service's default.",
          "title": "Base Url"
        },
        "credential": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProxySecret"
            },
            {
              "$ref": "#/$defs/EnvSecret"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The API key for the service. Absent means the agent uses whatever\ncredential its environment has for the service. A `proxy` credential is the\nkey alone; the proxy adds it as `provider`'s API expects.",
          "title": "Credential"
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "title": "Model",
      "type": "object"
    },
    "ModelPattern": {
      "additionalProperties": false,
      "description": "Matches the `provider` and `id` of a Commission's Model. `*` matches any characters.",
      "properties": {
        "provider": {
          "description": "A pattern for the model's `provider`, for example `\"anthropic\"`.",
          "title": "Provider",
          "type": "string"
        },
        "id": {
          "description": "A pattern for the model's `id`, for example `\"claude-*\"`.",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "title": "ModelPattern",
      "type": "object"
    },
    "ProxySecret": {
      "additionalProperties": false,
      "description": "A secret that a proxy outside the agent holds and adds to its requests.",
      "properties": {
        "proxy": {
          "description": "The name of a credential that a proxy outside the agent holds. The proxy\nadds it to the agent's matching requests, so the agent never receives its\nvalue.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Proxy",
          "type": "string"
        }
      },
      "required": [
        "proxy"
      ],
      "title": "ProxySecret",
      "type": "object"
    },
    "Reasoning": {
      "additionalProperties": false,
      "description": "A block of the model's reasoning: readable `text`, or `encrypted_content`\nwhen the service returned it encrypted.",
      "properties": {
        "type": {
          "const": "reasoning",
          "default": "reasoning",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "encrypted_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encrypted Content"
        }
      },
      "title": "Reasoning",
      "type": "object"
    },
    "ServerResult": {
      "additionalProperties": false,
      "description": "The result of a server-side `Call`, from the same response.",
      "properties": {
        "type": {
          "const": "server_result",
          "default": "server_result",
          "title": "Type",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Text"
                  },
                  {
                    "$ref": "#/$defs/Image"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Content"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "structured_content": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "call_id",
        "content"
      ],
      "title": "ServerResult",
      "type": "object"
    },
    "Subagent": {
      "additionalProperties": false,
      "description": "A subagent that ships with the agent. It does not inherit the agent's items.",
      "properties": {
        "name": {
          "description": "Identifies the subagent.",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the subagent does.",
          "title": "Description"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
