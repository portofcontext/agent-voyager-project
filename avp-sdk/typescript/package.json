{
  "name": "@agent-voyager-project/sdk",
  "version": "0.1.0-beta.2",
  "description": "AVP wire types and shared agent helpers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commission": {
      "types": "./dist/commission.d.ts",
      "import": "./dist/commission.js"
    },
    "./descriptor": {
      "types": "./dist/descriptor.d.ts",
      "import": "./dist/descriptor.js"
    },
    "./trajectory": {
      "types": "./dist/trajectory.d.ts",
      "import": "./dist/trajectory.js"
    },
    "./recorder": {
      "types": "./dist/recorder.d.ts",
      "import": "./dist/recorder.js"
    },
    "./agent_cli": {
      "types": "./dist/agent_cli.d.ts",
      "import": "./dist/agent_cli.js"
    },
    "./utils/preflight": {
      "types": "./dist/utils/preflight.d.ts",
      "import": "./dist/utils/preflight.js"
    },
    "./utils/run_plan": {
      "types": "./dist/utils/run_plan.d.ts",
      "import": "./dist/utils/run_plan.js"
    },
    "./utils/pricing": {
      "types": "./dist/utils/pricing.d.ts",
      "import": "./dist/utils/pricing.js"
    },
    "./utils/endpoints": {
      "types": "./dist/utils/endpoints.d.ts",
      "import": "./dist/utils/endpoints.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "node scripts/build.mjs",
    "format": "prettier --write src scripts tests package.json tsconfig.json tsconfig.test.json README.md",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json tsconfig.test.json README.md",
    "test": "node scripts/test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
