{
  "name": "@avp/types",
  "version": "0.1.0",
  "description": "Agent Voyager Project: TypeScript types and Recorder for the v0.1 wire format.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portofcontext/agent-voyager-project"
  },
  "keywords": [
    "avp",
    "agents",
    "llm",
    "wire-format",
    "cloudevents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commission": {
      "types": "./dist/commission.d.ts",
      "import": "./dist/commission.js"
    },
    "./trajectory": {
      "types": "./dist/trajectory.d.ts",
      "import": "./dist/trajectory.js"
    },
    "./agent-descriptor": {
      "types": "./dist/agent-descriptor.d.ts",
      "import": "./dist/agent-descriptor.js"
    },
    "./recorder": {
      "types": "./dist/recorder.d.ts",
      "import": "./dist/recorder.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "import": "./dist/pricing.js"
    },
    "./sink": {
      "types": "./dist/sink.d.ts",
      "import": "./dist/sink.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "import": "./dist/ids.js"
    },
    "./preflight": {
      "types": "./dist/preflight.d.ts",
      "import": "./dist/preflight.js"
    },
    "./agent-cli": {
      "types": "./dist/agent-cli.d.ts",
      "import": "./dist/agent-cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../python/src/avp/data/prices.json dist/prices.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/tests/*.test.js'",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
