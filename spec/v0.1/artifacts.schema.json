{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.agentvoyagerproject.com/schema/v0.1/artifacts.schema.json",
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\x00-\\x1f])[^/]+(?:/[^/]+)*$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "role",
        "sha256"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "avp_version": {
      "const": "0.1",
      "title": "Avp Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "avp_version",
    "run_id",
    "artifacts"
  ],
  "title": "AVP run artifacts",
  "type": "object",
  "description": "Captured run files. See artifacts.md."
}
