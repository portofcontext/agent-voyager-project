{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.agentvoyagerproject.com/schema/v0.1/agent-start.schema.json",
  "$defs": {
    "BinaryFile": {
      "additionalProperties": false,
      "properties": {
        "base64": {
          "title": "Base64",
          "type": "string"
        }
      },
      "required": [
        "base64"
      ],
      "title": "BinaryFile",
      "type": "object"
    },
    "EnvSecret": {
      "additionalProperties": false,
      "description": "A secret in a variable of the agent's environment.",
      "properties": {
        "env": {
          "description": "The name of a variable in the agent's environment that holds the secret,\nfor example `\"TEST_DB_PASSWORD\"`.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "EnvSecret",
      "type": "object"
    },
    "JsonValue": {},
    "McpServer": {
      "additionalProperties": false,
      "description": "An MCP server the agent comes with. Connection details stay inside the agent.",
      "properties": {
        "id": {
          "description": "Identifies the server. A Tool's `mcp_server_id` refers to it.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A display name, when it differs from `id`.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server provides.",
          "title": "Description"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "connected",
                "failed",
                "needs-auth",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The result of the agent's attempt to connect.",
          "title": "Status"
        }
      },
      "required": [
        "id"
      ],
      "title": "McpServer",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "description": "A Model without its `credential`, as the Trajectory reports it.",
      "properties": {
        "provider": {
          "description": "The service that runs the model, for example `\"anthropic\"`,\n`\"amazon-bedrock\"`, or `\"openrouter\"`. It decides which API the agent calls\nand how it authenticates.",
          "pattern": "^[a-z0-9._-]+$",
          "title": "Provider",
          "type": "string"
        },
        "id": {
          "description": "The model's ID at that service, as the agent sends it, for example\n`\"claude-sonnet-4-6\"`.",
          "title": "Id",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The URL of the service's API. Absent means the service's default.",
          "title": "Base Url"
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "ProxySecret": {
      "additionalProperties": false,
      "description": "A secret that a proxy outside the agent holds and adds to its requests.",
      "properties": {
        "proxy": {
          "description": "The name of a credential that a proxy outside the agent holds. The proxy\nadds it to the agent's matching requests, so the agent never receives its\nvalue.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Proxy",
          "type": "string"
        }
      },
      "required": [
        "proxy"
      ],
      "title": "ProxySecret",
      "type": "object"
    },
    "StartedMcpHttp": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identifies the server.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A display name, when it differs from `id`.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server provides.",
          "title": "Description"
        },
        "type": {
          "const": "http",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "description": "The server's URL.",
          "title": "Url",
          "type": "string"
        },
        "headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/ProxySecret"
                  },
                  {
                    "$ref": "#/$defs/EnvSecret"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP headers to send with each request. A Secret reference's secret is\nthe header's entire value.",
          "title": "Headers"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "connected",
                "failed",
                "needs-auth",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "id",
        "type",
        "url"
      ],
      "title": "StartedMcpHttp",
      "type": "object"
    },
    "StartedMcpStdio": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identifies the server.",
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A display name, when it differs from `id`.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server provides.",
          "title": "Description"
        },
        "type": {
          "const": "stdio",
          "title": "Type",
          "type": "string"
        },
        "command": {
          "description": "The program and its arguments, for example `[\"npx\", \"-y\", \"@example/db-mcp\"]`.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "env": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/EnvSecret"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Environment variables to set for the program, on top of those the\nagent's MCP client gives it.",
          "title": "Env"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "connected",
                "failed",
                "needs-auth",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "id",
        "type",
        "command"
      ],
      "title": "StartedMcpStdio",
      "type": "object"
    },
    "StartedSkill": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "description": "The skill's name.",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "description": "What the skill does and when to use it.",
          "title": "Description",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^file:",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A `file:` URI for the directory that contains the skill's `SKILL.md`, as\nthe path appears inside the agent's environment.",
          "title": "Source"
        },
        "files": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/BinaryFile"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Files"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "StartedSkill",
      "type": "object"
    },
    "StartedSubagent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Tool"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "skills": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/StartedSkill"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skills"
        },
        "mcp_servers": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StartedMcpHttp"
                  },
                  {
                    "$ref": "#/$defs/StartedMcpStdio"
                  },
                  {
                    "$ref": "#/$defs/McpServer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Servers"
        }
      },
      "required": [
        "name"
      ],
      "title": "StartedSubagent",
      "type": "object"
    },
    "Tool": {
      "additionalProperties": true,
      "description": "An MCP `Tool` object, with one added field. Other MCP fields are kept.",
      "properties": {
        "name": {
          "description": "The tool's name, as the model calls it.",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A display name.",
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the tool does, as the model sees it.",
          "title": "Description"
        },
        "inputSchema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "A JSON Schema for the tool's input, as the model sees it.",
          "properties": {
            "type": {
              "const": "object"
            }
          },
          "required": [
            "type"
          ],
          "title": "Inputschema",
          "type": "object"
        },
        "outputSchema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "properties": {
                "type": {
                  "const": "object"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A JSON Schema for the tool's structured output.",
          "title": "Outputschema"
        },
        "mcp_server_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The `id` of the MCP server the tool comes from. Absent for any tool that\ndoes not come from an MCP server.",
          "title": "Mcp Server Id"
        }
      },
      "required": [
        "name",
        "inputSchema"
      ],
      "title": "Tool",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "avp_version": {
      "const": "0.1",
      "title": "Avp Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "system_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Prompt"
    },
    "model": {
      "$ref": "#/$defs/ModelRef"
    },
    "tools": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Tool"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools"
    },
    "mcp_servers": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/StartedMcpHttp"
              },
              {
                "$ref": "#/$defs/StartedMcpStdio"
              },
              {
                "$ref": "#/$defs/McpServer"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mcp Servers"
    },
    "skills": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/StartedSkill"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skills"
    },
    "subagents": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/StartedSubagent"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subagents"
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "properties": {
            "type": {
              "const": "object"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Schema"
    }
  },
  "required": [
    "avp_version",
    "run_id",
    "prompt",
    "model"
  ],
  "title": "AVP v0.1 Agent Start",
  "type": "object",
  "description": "Resolved configuration at start. See agent-start.md."
}
