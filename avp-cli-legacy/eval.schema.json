{
  "$defs": {
    "FileDataset": {
      "additionalProperties": false,
      "description": "Rows from a local `.json` / `.jsonl` file. Either the rows already have\nthe `{id, prompt, expected}` shape (omit `input`), or `input` is a template\nover row fields (EVAL-FORMAT.md §3; strict: unknown field names error) with\n`expected_field` / `id_field` naming the mapped columns.",
      "properties": {
        "source": {
          "const": "file",
          "title": "Source",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input"
        },
        "expected_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Field"
        },
        "id_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Field"
        },
        "expected_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Pattern"
        },
        "expected_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Key"
        }
      },
      "required": [
        "source",
        "path"
      ],
      "title": "FileDataset",
      "type": "object"
    },
    "HuggingFaceDataset": {
      "additionalProperties": false,
      "description": "Rows from a Hugging Face dataset (needs the `huggingface` extra).",
      "properties": {
        "source": {
          "const": "huggingface",
          "title": "Source",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "split": {
          "title": "Split",
          "type": "string"
        },
        "input": {
          "title": "Input",
          "type": "string"
        },
        "config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config"
        },
        "expected_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Field"
        },
        "id_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Field"
        },
        "expected_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Pattern"
        },
        "expected_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Key"
        }
      },
      "required": [
        "source",
        "id",
        "split",
        "input"
      ],
      "title": "HuggingFaceDataset",
      "type": "object"
    },
    "InlineDataset": {
      "additionalProperties": false,
      "description": "Cases carried in the config: the zero-dependency source.",
      "properties": {
        "source": {
          "const": "inline",
          "title": "Source",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/InlineItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "source",
        "items"
      ],
      "title": "InlineDataset",
      "type": "object"
    },
    "InlineItem": {
      "additionalProperties": false,
      "description": "One dataset case, carried in the config itself.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "InlineItem",
      "type": "object"
    },
    "LLMJudgeSpec": {
      "additionalProperties": false,
      "description": "A model judge with Commission-style routing and credential references.",
      "properties": {
        "name": {
          "const": "llm-judge",
          "title": "Name",
          "type": "string"
        },
        "model": {
          "pattern": "^[^/]+/.+$",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "required": [
        "name",
        "model"
      ],
      "title": "LLMJudgeSpec",
      "type": "object"
    },
    "Provider": {
      "additionalProperties": false,
      "description": "Optional LLM routing override: which storefront serves the model.\n\nAbsent → the agent uses its native default (whatever its own environment\nconfigures). Present → the supervisor directs the agent at a specific\nendpoint. `id` selects the protocol/auth family (e.g. \"anthropic\",\n\"openai\", \"openrouter\"); `base_url` overrides the endpoint; `credential`\nreferences the API key by vault handle (never the value).\n\nThe model's origin (the `Commission.model` slug's first segment) and the\nstorefront `id` are independent axes: `model: \"openai/gpt-4o\"` with\n`provider.id: \"openrouter\"` reads as \"OpenAI's gpt-4o, bought through\nOpenRouter\". An agent that cannot speak the requested provider's protocol\nMUST fail (error_occurred + agent_stopped reason=error), never silently\nrun elsewhere.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "credential": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "title": "Provider",
      "type": "object"
    },
    "ScorerSpec": {
      "additionalProperties": false,
      "description": "A deterministic scorer; threshold applies to the structural scorers.",
      "properties": {
        "name": {
          "enum": [
            "exact-match",
            "structural-match",
            "structural-fidelity"
          ],
          "title": "Name",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "name"
      ],
      "title": "ScorerSpec",
      "type": "object"
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "A reference to a secret the supervisor resolves out of band.\n\nCarries a `vault` handle, never the secret value. The supervisor maps the\nhandle to material (env var, secrets file, broker) at run time; the value\nnever appears on the wire or in the trajectory. Used by `Provider.credential`\nand `McpServerHttp.auth`.",
      "properties": {
        "vault": {
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$",
          "title": "Vault",
          "type": "string"
        }
      },
      "required": [
        "vault"
      ],
      "title": "SecretRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One eval: a dataset, a scorer, and the library commissions to compare, optionally bound per agent (map keys are each agent's descriptor.agent_name). Authored as <name>.eval.json. The templating, commission-reference, and run-stamping rules an implementation must reproduce are in avp-cli/EVAL-FORMAT.md.",
  "properties": {
    "eval_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Eval Version",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "agents": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agents"
    },
    "dataset": {
      "discriminator": {
        "mapping": {
          "file": "#/$defs/FileDataset",
          "huggingface": "#/$defs/HuggingFaceDataset",
          "inline": "#/$defs/InlineDataset"
        },
        "propertyName": "source"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/InlineDataset"
        },
        {
          "$ref": "#/$defs/FileDataset"
        },
        {
          "$ref": "#/$defs/HuggingFaceDataset"
        }
      ],
      "title": "Dataset"
    },
    "scorer": {
      "discriminator": {
        "mapping": {
          "exact-match": "#/$defs/ScorerSpec",
          "llm-judge": "#/$defs/LLMJudgeSpec",
          "structural-fidelity": "#/$defs/ScorerSpec",
          "structural-match": "#/$defs/ScorerSpec"
        },
        "propertyName": "name"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ScorerSpec"
        },
        {
          "$ref": "#/$defs/LLMJudgeSpec"
        }
      ],
      "title": "Scorer"
    },
    "commissions": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        }
      ],
      "minLength": 1,
      "title": "Commissions"
    }
  },
  "required": [
    "dataset",
    "scorer",
    "commissions"
  ],
  "title": "AVP eval config 0.1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avp.dev/schema/eval/0.1/eval.schema.json"
}